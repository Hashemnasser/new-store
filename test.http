# ### ============================================================
# ### 📦 API TEST FILE - REST Client
# ### ============================================================
# ### BASE URL: http://localhost:5000/api
# ### ============================================================

@baseUrl = http://localhost:5000/api
 @token = {{signIn.response.body.data.token}}
 @productId={{product.response.body.data.id}}
# ### ============================================================
# ### 🔐 1. AUTH ROUTES
# ### ============================================================

# ### 1.1 Register New User
POST {{baseUrl}}/auth/signup
Content-Type: application/json

{
  "name": "Hashem",
  "email": "hashem19851985@gmail.com",
  "password": "abcde123456"
}

# ### 1.2 Sign In
# # @name signIn
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "hashem19851985@gmail.com",
  "password": "abcde12345"
}

# ### 1.3 Get Profile (Protected)
# GET {{baseUrl}}/auth/profile
# Authorization: Bearer {{token}}

# ### 1.4 Update Profile (Protected)
# PATCH {{baseUrl}}/auth/profile
# Authorization: Bearer {{token}}
# Content-Type: application/json

# {
#   "name": "Updated Test User",
#   "image": "https://ui-avatars.com/api/?name=Test"
# }

# ### 1.5 Change Password (Protected)
# POST {{baseUrl}}/auth/change-password
# Authorization: Bearer {{token}}
# Content-Type: application/json

# {
#   "currentPassword": "123456",
#   "newPassword": "1234567"
# }

# ### ============================================================
# ### 📂 2. CATEGORY ROUTES
# ### ============================================================

# ### 2.1 Get All Categories
# GET {{baseUrl}}/categories

# ### 2.2 Create Category (Admin Only)
POST {{baseUrl}}/categories
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Phones"
}

# ### 2.3 Create Another Category
# POST {{baseUrl}}/categories
# Authorization: Bearer {{token}}
# Content-Type: application/json

# {
#   "name": "Accessories"
# }

# ### ============================================================
# ### 🛍️ 3. PRODUCT ROUTES
# ### ============================================================

# ### 3.1 Get All Products
 GET {{baseUrl}}/product/top-selling

# ### 3.2 Get Product by Slug
GET http://localhost:5000/api/products/top-selling

# ### 3.3 Create Product (Admin Only)
# # @name product
POST {{baseUrl}}/products
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJ1c2VySWQiOiJjbXNtODNmNzIwMDAwdXV4NHdrbXV1NG90IiwiaWF0IjoxNzg2MzY4OTAzLCJleHAiOjE3ODY5NzM3MDN9.KYn4J9xJ38R0g_KVrs4AdXD3UtZzn7u75e80Zvgfbkw
Content-Type: application/json

