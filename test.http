  "title": "iPhone 16 pro",
  "description": "Latest iPhone with titanium frame and A17 Pro chip",
  "categoryId": "cmsjbb7i10001uuro4smf0amn",
  "images": [
    {
      "url": "https://images.unsplash.com/photo-1511707171634-5f897ff02aa9?auto=format&fit=crop&w=400&q=80 ",
